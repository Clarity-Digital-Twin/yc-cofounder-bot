# Engines
ENABLE_CUA=1                            # Use OpenAI Computer Use (primary)
ENABLE_PLAYWRIGHT_FALLBACK=1            # Auto-fallback if CUA fails
ENABLE_PLAYWRIGHT=0                     # Force Playwright (debugging only)

# OpenAI
OPENAI_API_KEY=sk-...                   # Your OpenAI API key
CUA_MODEL=<your-computer-use-model>     # From your Models endpoint
CUA_TEMPERATURE=0.3
CUA_MAX_TOKENS=1200

# Decision Engine (AI-ONLY MODE)
OPENAI_DECISION_MODEL=gpt-5             # Use gpt-5 (NOT gpt-5-thinking!)
AUTO_SEND=0                             # 0 = require approval, 1 = send on YES

# GPT-5 Specific Settings (Per Context7 Documentation)
GPT5_MAX_TOKENS=4000                    # Up to 128,000 supported (we use 4000 default)
GPT5_TEMPERATURE=0.3                    # 0-2 range (lower = more focused)
GPT5_TOP_P=0.9                          # Nucleus sampling (alternative to temperature)
GPT5_VERBOSITY=low                      # low/medium/high (nested in text object)
GPT5_REASONING_EFFORT=minimal           # minimal/low/medium/high (for speed vs depth)
SERVICE_TIER=auto                       # auto/default/flex/priority

# Runtime & Safety
YC_MATCH_URL=https://www.startupschool.org/cofounder-matching
SEND_DELAY_MS=5000                      # Milliseconds between sends
DAILY_QUOTA=25
WEEKLY_QUOTA=120
SHADOW_MODE=0                           # 1 = evaluate-only (never send)

# Repo-scoped Caches (no $HOME writes)
UV_LINK_MODE=copy
UV_CACHE_DIR=.uv_cache
XDG_CACHE_HOME=.cache
PLAYWRIGHT_BROWSERS_PATH=.ms-playwright
MPLCONFIGDIR=.mplconfig

# Browser Settings
PLAYWRIGHT_HEADLESS=0                   # 0 = visible browser, 1 = headless

# YC Login Credentials (optional - for automated login)
# YC_EMAIL=your_email@example.com
# YC_PASSWORD=your_password